pipeline {
    agent any

    environment {
        SERVICE_NAME = "gateway-service"
        NAMESPACE = "taller2-stage"
        IMAGE_NAME = "$SERVICE_NAME:latest"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            // Invocación Gradle: compila + unit tests + integration tests
            steps {
                dir("services/circleguard-$SERVICE_NAME") {
                    sh "../../gradlew clean build"
                }
            }
            post {
                always {
                    junit "services/circleguard-$SERVICE_NAME/build/test-results/**/*.xml"
                }
            }
        }

        stage('Docker Build') {
            // Build local para Docker Desktop
            steps {
                dir("services/circleguard-$SERVICE_NAME") {
                    sh "docker build -t $IMAGE_NAME ."
                }
            }
        }

        stage('Deploy to Stage') {
            steps {
                sh "cp /root/.kube/config /tmp/kubeconfig"
                sh "sed -i 's/127.0.0.1/host.docker.internal/g' /tmp/kubeconfig"
                
                withEnv(["KUBECONFIG=/tmp/kubeconfig"]) {
                    // Aplicar manifiesto específico de este servicio
                    sh "kubectl apply -f k8s/stage/gateway-service.yaml -n $NAMESPACE --insecure-skip-tls-verify"
                    sh "kubectl rollout restart deployment/$SERVICE_NAME -n $NAMESPACE --insecure-skip-tls-verify"
                    sh "kubectl rollout status deployment/$SERVICE_NAME -n $NAMESPACE --insecure-skip-tls-verify --timeout=300s"
                }
            }
        }

        stage('Smoke Tests') {
            // Pruebas de la aplicación desplegada en Kubernetes (Actividad 4).
            // Verifica /actuator/health vía port-forward y ejecuta Locust.
            steps {
                sh "cp /root/.kube/config /tmp/kubeconfig"
                sh "sed -i 's/127.0.0.1/host.docker.internal/g' /tmp/kubeconfig"
                
                withEnv(["KUBECONFIG=/tmp/kubeconfig"]) {
                    script {
                        sh "nohup kubectl port-forward svc/gateway-service 8087:8087 -n $NAMESPACE --insecure-skip-tls-verify > pf-gateway.log 2>&1 &"
                        sleep 30 // Aumentamos el tiempo para que el port-forward sea estable

                        try {
                            // Smoke Test
                            sh '''
                                STATUS=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:8087/actuator/health)
                                if [ "$STATUS" = "200" ]; then
                                    echo "SMOKE OK  — port 8087 → HTTP $STATUS"
                                else
                                    echo "SMOKE FAIL — port 8087 → HTTP $STATUS"
                                    exit 1
                                fi
                            '''

                        } finally {
                            sh "pkill -f 'kubectl port-forward' || true"
                        }
                    }
                }
            }
        }
    }

    post {
        success { echo "Build ${BUILD_NUMBER} desplegado y verificado en ${NAMESPACE}" }
        failure { echo "Pipeline STAGE falló en build ${BUILD_NUMBER}" }
        always  { cleanWs() }
    }
}
