// Pipeline STAGE UNIFICADO — build + tests + docker + deploy + smoke tests
pipeline {
    agent any

    environment {
        NAMESPACE = "taller2-stage"
        // Lista de servicios a procesar
        SERVICES  = "auth identity promotion notification form gateway"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                // Compilación paralela de todos los servicios. 
                // Usamos build para incluir tests unitarios/integración.
                // No usamos clean para aprovechar el caché de Gradle.
                sh "./gradlew build --parallel"
                
                // Aseguramos que cada servicio tenga su app.jar listo para Docker
                sh '''
                    for SERVICE in ${SERVICES}; do
                        LIBS="services/circleguard-${SERVICE}-service/build/libs"
                        JAR=$(ls ${LIBS}/*.jar | grep -v plain | head -1 || true)
                        if [ -n "$JAR" ]; then
                            cp "$JAR" "${LIBS}/app.jar"
                        fi
                    done
                '''
            }
            post {
                always {
                    // Recolectar resultados de tests de todos los servicios
                    junit 'services/*/build/test-results/**/*.xml'
                }
            }
        }

        stage('Docker Build') {
            steps {
                script {
                    // Construcción de imágenes en paralelo localmente
                    def dockerBuilds = [:]
                    def servicesList = env.SERVICES.split(' ')
                    
                    servicesList.each { service ->
                        dockerBuilds["Build ${service}"] = {
                            dir("services/circleguard-${service}-service") {
                                sh "docker build -t ${service}-service:latest ."
                            }
                        }
                    }
                    parallel dockerBuilds
                }
            }
        }

        stage('Deploy to Stage') {
            steps {
                sh "cp /root/.kube/config /tmp/kubeconfig"
                sh "sed -i 's/127.0.0.1/host.docker.internal/g' /tmp/kubeconfig"
                
                withEnv(["KUBECONFIG=/tmp/kubeconfig"]) {
                    // Aplicamos todos los manifiestos de la carpeta stage (infraestructura + servicios)
                    sh "kubectl apply -f k8s/stage/ -n ${NAMESPACE} --insecure-skip-tls-verify"
                    
                    // Esperamos a que los servicios críticos estén listos
                    // Esto cumple con la validación de despliegue
                    sh "kubectl rollout status deployment/auth-service -n ${NAMESPACE} --insecure-skip-tls-verify --timeout=300s"
                    sh "kubectl rollout status deployment/gateway-service -n ${NAMESPACE} --insecure-skip-tls-verify --timeout=300s"
                    sh "kubectl rollout status deployment/identity-service -n ${NAMESPACE} --insecure-skip-tls-verify --timeout=300s"
                }
            }
        }

        stage('Global Smoke Tests') {
            steps {
                withEnv(["KUBECONFIG=/tmp/kubeconfig"]) {
                    script {
                        // Mapeo de servicios y sus puertos internos
                        def ports = [
                            "auth-service": 8180,
                            "identity-service": 8083,
                            "gateway-service": 8087,
                            "promotion-service": 8088
                        ]
                        
                        // Iniciar port-forwards en background
                        ports.each { service, port ->
                            sh "nohup kubectl port-forward svc/${service} ${port}:${port} -n ${NAMESPACE} --insecure-skip-tls-verify > pf-${service}.log 2>&1 &"
                        }
                        
                        sleep 20 // Esperar estabilidad de los túneles
                        
                        try {
                            ports.each { service, port ->
                                sh """
                                    STATUS=\$(curl -s -o /dev/null -w "%{http_code}" http://localhost:${port}/actuator/health)
                                    if [ "\$STATUS" = "200" ]; then
                                        echo "SMOKE OK  — ${service} en puerto ${port} → HTTP \$STATUS"
                                    else
                                        echo "SMOKE FAIL — ${service} en puerto ${port} → HTTP \$STATUS"
                                        exit 1
                                    fi
                                """
                            }
                        } finally {
                            // Limpiar procesos de port-forward
                            sh "pkill -f 'kubectl port-forward' || true"
                        }
                    }
                }
            }
        }
    }

    post {
        success { echo "Entorno STAGE completo desplegado y verificado correctamente." }
        failure { echo "El Pipeline Global de STAGE falló en alguna etapa." }
        always  { cleanWs() }
    }
}
